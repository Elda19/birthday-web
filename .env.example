# ---------------------------------------------------------------------------
# Copy this file to ".env.local" and paste in your two Supabase values.
# Find them in Supabase:  Project Settings -> API
# ---------------------------------------------------------------------------

# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# "anon public" key. This one is safe to expose - it is meant for browsers.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# NEVER put the "service_role" key in this file. The website does not need it.
